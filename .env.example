DB_HOST=localhost
DB_PORT=3306
DB_USER=homefinder
DB_PASS=change-me
DB_NAME=homefinder
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
NODE_ENV=development

# --- Optional ---
# Public address of the site (used in emailed links, sitemap and social previews)
# BASE_URL=https://homes.example.com
# Prices are shown in this ISO currency code (BDT, USD, EUR, ...)
# CURRENCY=BDT
# Default map view: "lat,lng" and zoom
# MAP_CENTER=23.8103,90.4125
# MAP_ZOOM=11
# Number of reverse proxies in front of the app (1 for NGINX/Caddy/most hosts, 0 if none)
# TRUST_PROXY=1
# Password-reset emails via https://resend.com. Without these, reset links are printed in the server console.
# RESEND_API_KEY=
# MAIL_FROM="Home Finder <no-reply@your-domain>"
